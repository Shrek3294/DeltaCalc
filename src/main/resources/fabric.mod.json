{
  "schemaVersion": 1,
  "id": "cobblemonextendedbattleui",
  "version": "${version}",
  "name": "DeltaCalc",
  "description": "Client-side damage calculator and battle overlays for Cobblemon Delta battles.",
  "authors": ["Shrek3294"],
  "contributors": ["sveniik"],
  "contact": {
    "sources": "https://github.com/nickmatteo/DeltaCalc",
    "issues": "https://github.com/nickmatteo/DeltaCalc/issues"
  },
  "license": "MIT",
  "icon": "assets/cobblemonextendedbattleui/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      {
        "adapter": "kotlin",
        "value": "com.cobblemonextendedbattleui.CobblemonExtendedBattleUIClient"
      }
    ],
    "main": [
      {
        "adapter": "kotlin",
        "value": "com.cobblemonextendedbattleui.CobblemonExtendedBattleUI"
      }
    ],
    "modmenu": [
      {
        "adapter": "kotlin",
        "value": "com.cobblemonextendedbattleui.ModMenuIntegration"
      }
    ]
  },
  "mixins": [
    "cobblemonextendedbattleui.mixins.json"
  ],
  "accessWidener": "cobblemonextendedbattleui.accesswidener",
  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric-api": "*",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-language-kotlin": ">=1.12.0",
    "cobblemon": ">=1.7.3"
  },
  "suggests": {
    "modmenu": "*",
    "cloth-config": "*"
  },
  "custom": {
    "modmenu": {
      "update_checker": false
    }
  }
}
